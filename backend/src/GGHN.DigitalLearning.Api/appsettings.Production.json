{
  "ConnectionStrings": {
    "DefaultConnection": "Set via environment variable ConnectionStrings__DefaultConnection"
  },
  "Jwt": {
    "Key": "Set via environment variable Jwt__Key (min 32 chars)",
    "Issuer": "GGHN.DigitalLearning.Api",
    "Audience": "GGHN.DigitalLearning.Web",
    "ExpiryInHours": 24
  },
  "SeedData": {
    "Enabled": true,
    "ResetOnStartup": false
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}